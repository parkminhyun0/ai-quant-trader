TRADING_ENV=TEST
BROKER_NAME=FAKE
DATABASE_URL=sqlite:///state/ai_quant_trader.db

# Never commit real credentials.
BROKER_API_KEY=
BROKER_API_SECRET=

# Korea Investment & Securities Open API (server-side only)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Local visual verification only. Never treat demo rows as market data.
MARKET_DATA_DEMO=false
MARKET_DATA_REFRESH_SECONDS=30

# Live trading remains disabled unless an approved implementation checks this.
CONFIRM_LIVE_TRADING=
